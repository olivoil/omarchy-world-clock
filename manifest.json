{
  "schemaVersion": 1,
  "id": "io.github.olivoil.world-clock",
  "name": "World Clock",
  "version": "0.3.0",
  "author": "Olivier Melcher",
  "description": "Compare, convert, and pin time across a user-managed list of places.",
  "license": "MIT",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "quattro/WorldClock.qml"
  },
  "barWidget": {
    "displayName": "World Clock",
    "description": "Compare, convert, and pin time across a user-managed list of places.",
    "category": "Time",
    "allowMultiple": false,
    "defaultSection": "center",
    "defaults": {
      "command": "omarchy-world-clock"
    },
    "schema": [
      {
        "key": "command",
        "type": "string",
        "label": "Backend command",
        "defaultValue": "omarchy-world-clock"
      }
    ]
  }
}
