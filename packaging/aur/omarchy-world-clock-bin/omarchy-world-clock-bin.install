post_install() {
  cat <<'EOF'
Omarchy World Clock was installed to /usr/bin/omarchy-world-clock.

To add it to your current user's Omarchy bar, run:

  omarchy-world-clock install

On Omarchy 4 this installs the native Quattro plugin after the calendar clock
and migrates the old command widget. On Omarchy 3 it installs the legacy Waybar
module.

This is an unofficial Omarchy integration.
EOF
}

post_upgrade() {
  post_install
}
